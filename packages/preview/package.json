{
  "name": "@wavr/preview",
  "version": "0.1.0",
  "description": "Compact in-preview Wavr editor overlay for agent and local landing-page workflows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./iife": "./dist/wavr-preview.js"
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@wavr/core": "workspace:*",
    "@wavr/schema": "workspace:*",
    "happy-dom": "^15.11.7",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
